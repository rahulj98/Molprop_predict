# Copy this file to .env and adjust if you need to. `.env` is gitignored --
# never commit real secrets. Nothing here is secret today: the project has no
# API keys, no cloud credentials and no remote services, and this file exists
# to document the one setting that does change between machines.

# Which checkpoint the API serves.
#
# Read by `molecular_property_predictor.api.service.resolve_model_path`, which
# prefers an explicit argument, then this variable, then the built-in default
# of `models/served.pt`. The Dockerfile sets it to the path the checkpoint is
# baked in at, which is how the same image runs unchanged here and in a
# container: code identical everywhere, configuration injected per environment.
#
# Point it at any artifact written by `model.save_artifact` -- the API checks
# on start-up that the recorded feature width matches the weights, and refuses
# to serve a mismatch rather than returning plausible nonsense.
MODEL_PATH=models/served.pt
