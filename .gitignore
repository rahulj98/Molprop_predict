# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Environment variables / secrets ---
.env

# --- PyCharm / IDE ---
.idea/
*.iml

# --- Claude Code ---
# Per-machine settings only. A shared .claude/settings.json, if we add one,
# is meant to be committed.
.claude/settings.local.json

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data (raw/processed data isn't committed; keep folder structure via .gitkeep) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- ML artifacts ---
mlruns/
mlartifacts/
# Trained artifacts and their training histories are build outputs: they are
# reproducible from the code plus the recorded seeds, and a 4 MB checkpoint has
# no business in git history.
#
# `models/*` rather than `models/`: git does not descend into an excluded
# directory, so a negation below could never re-include anything inside it.
models/*
*.pt
*.pth
*.ckpt
*.onnx

# The one deliberate exception (Phase 7). The Dockerfile bakes this checkpoint
# into the image, so the build has to be reproducible from a clone -- a
# gitignored input would mean `docker build` produces a container that starts
# with no model. 4.2 MB, committed knowingly, and only this one file: every
# other checkpoint stays a build output.
!models/served.pt

# --- Docker ---
*.log

# --- OS ---
.DS_Store
Thumbs.db

# --- Working notes ---
# Running build diary, kept local for now. Duplicates what the commit
# messages already record, so it is not part of the public repo.
progress.txt

# --- pytest ---
# pytest writes its own .gitignore inside this directory, so it is already
# invisible to git; naming it here is for readers, not for git.
.pytest_cache/
